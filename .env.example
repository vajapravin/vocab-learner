# Which provider to use: "anthropic" or "openai"
VOCAB_LEARNER_LLM_PROVIDER=openai

# OpenAI (required if provider=openai)
OPENAI_API_KEY=sk-proj-it

# Anthropic (required if provider=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

VOCAB_LEARNER_EXTRACTION_MODEL=gpt-4.1
VOCAB_LEARNER_TEACHING_MODEL=gpt-4.1
VOCAB_LEARNER_LOG_LEVEL=INFO
VOCAB_LEARNER_OUTPUT_DIR=./output