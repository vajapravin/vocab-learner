# Which provider to use: "local", "openai", or "anthropic"
VOCAB_LEARNER_LLM_PROVIDER=local

# Local GGUF Model (when provider=local; uses Metal GPU on macOS)
VOCAB_LEARNER_LOCAL_MODEL_PATH=./models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
VOCAB_LEARNER_LOCAL_GPU_LAYERS=-1
VOCAB_LEARNER_LOCAL_CONTEXT_LENGTH=4096

# OpenAI (required if provider=openai)
OPENAI_API_KEY=sk-proj-it

# Anthropic (required if provider=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

VOCAB_LEARNER_EXTRACTION_MODEL=qwen2.5-7b-instruct
VOCAB_LEARNER_TEACHING_MODEL=qwen2.5-7b-instruct
VOCAB_LEARNER_LOG_LEVEL=INFO
VOCAB_LEARNER_OUTPUT_DIR=./output

# --- Email (optional; only used when --email is passed) -------------------
# Gmail SMTP. Use a Google App Password (not your regular password):
# https://support.google.com/mail/answer/185833
VOCAB_LEARNER_SMTP_HOST=smtp.gmail.com
VOCAB_LEARNER_SMTP_PORT=587
VOCAB_LEARNER_SMTP_USER=your.email@gmail.com
VOCAB_LEARNER_SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
VOCAB_LEARNER_EMAIL_FROM=your.email@gmail.com
VOCAB_LEARNER_EMAIL_TO=your.email@gmail.com

# Directory the `daily` command scans for IMG_YYYY-MM-DD.jpg files.
# On Synology: /volume1/homes/dictionary/IMG
VOCAB_LEARNER_INBOX_DIR=./inbox