# Which provider to use: "groq", "huggingface", "openai", or "anthropic"
VOCAB_LEARNER_LLM_PROVIDER=groq

# Groq (Free fast inference with vision and text models)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_api_key_here
# Optional multiple keys for rotation:
# GROQ_API_KEYS=gsk_key1,gsk_key2
# Optional numbered keys:
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Preferred Groq models (vision model for page extraction, versatile text model for cards & stories)
VOCAB_LEARNER_EXTRACTION_MODEL=qwen/qwen3.8-27b
VOCAB_LEARNER_TEACHING_MODEL=openai/gpt-oss-120b

# SQLite minimal token tracking and rate limiting (per-model RPM, RPD, TPM, TPD)
VOCAB_LEARNER_SQLITE_DB_PATH=./output/llm_usage.db
# Default fallback limits (Groq models also use per-model limits automatically:
# e.g. groq/compound: 30 RPM, 250 RPD, 70,000 TPM; llama-3.1-8b: 30 RPM, 14,400 RPD, 6,000 TPM; llama-3.3-70b: 30 RPM, 1,000 RPD, 12,000 TPM)
VOCAB_LEARNER_RPM_LIMIT=30
VOCAB_LEARNER_RPD_LIMIT=1000
VOCAB_LEARNER_TPM_LIMIT=30000
VOCAB_LEARNER_DAILY_TOKEN_LIMIT=500000

VOCAB_LEARNER_LOG_LEVEL=INFO
VOCAB_LEARNER_OUTPUT_DIR=./output

# Optional: Hugging Face (supports serverless models)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Optional: OpenAI (fallback)
OPENAI_API_KEY=sk-proj-...

# Optional: Anthropic (fallback)
ANTHROPIC_API_KEY=sk-ant-...

# --- Email (optional; only used when --email is passed) -------------------
# Gmail SMTP. Use a Google App Password (not your regular password):
# https://support.google.com/mail/answer/185833
VOCAB_LEARNER_SMTP_HOST=smtp.gmail.com
VOCAB_LEARNER_SMTP_PORT=587
VOCAB_LEARNER_SMTP_USER=your.email@gmail.com
VOCAB_LEARNER_SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
VOCAB_LEARNER_EMAIL_FROM=your.email@gmail.com
VOCAB_LEARNER_EMAIL_TO=your.email@gmail.com

# Directory the `daily` command scans for IMG_YYYY-MM-DD.jpg files.
# On Synology: /volume1/homes/dictionary/IMG
VOCAB_LEARNER_INBOX_DIR=./inbox
VOCAB_LEARNER_MAX_TOKENS=4096