# Which provider to use: "huggingface", "openai", or "anthropic"
VOCAB_LEARNER_LLM_PROVIDER=huggingface

# Hugging Face (supports 30 distinct LLMs, automatic token limit checks & switching)
# You can provide a primary key or multiple keys for automatic key rotation.
HUGGINGFACE_API_KEY=hf_your_primary_access_token_here
# Optional: comma-separated list of additional keys or HF_TOKEN
# HUGGINGFACE_API_KEYS=hf_token_1,hf_token_2
# Optional numbered keys:
# HUGGINGFACE_API_KEY_1=hf_...
# HUGGINGFACE_API_KEY_2=hf_...

# Hugging Face Router endpoint (OpenAI compatible)
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# SQLite minimal token tracking and rate limiting
VOCAB_LEARNER_SQLITE_DB_PATH=./output/llm_usage.db
VOCAB_LEARNER_TPM_LIMIT=30000
VOCAB_LEARNER_RPM_LIMIT=30
VOCAB_LEARNER_DAILY_TOKEN_LIMIT=500000

# Preferred default free models (system automatically checks token limits and switches if exceeded)
VOCAB_LEARNER_EXTRACTION_MODEL=Qwen/Qwen3.5-9B
VOCAB_LEARNER_TEACHING_MODEL=meta-llama/Llama-3.1-8B-Instruct
VOCAB_LEARNER_LOG_LEVEL=INFO
VOCAB_LEARNER_OUTPUT_DIR=./output

# OpenAI (required if provider=openai)
OPENAI_API_KEY=sk-proj-...

# Anthropic (required if provider=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# --- Email (optional; only used when --email is passed) -------------------
# Gmail SMTP. Use a Google App Password (not your regular password):
# https://support.google.com/mail/answer/185833
VOCAB_LEARNER_SMTP_HOST=smtp.gmail.com
VOCAB_LEARNER_SMTP_PORT=587
VOCAB_LEARNER_SMTP_USER=your.email@gmail.com
VOCAB_LEARNER_SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
VOCAB_LEARNER_EMAIL_FROM=your.email@gmail.com
VOCAB_LEARNER_EMAIL_TO=your.email@gmail.com

# Directory the `daily` command scans for IMG_YYYY-MM-DD.jpg files.
# On Synology: /volume1/homes/dictionary/IMG
VOCAB_LEARNER_INBOX_DIR=./inbox
VOCAB_LEARNER_MAX_TOKENS=4096